    "HOOP. No data yet, open HOOP on your iPhone to sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Noch keine Daten, öffne HOOP auf deinem iPhone zum Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. No data yet, open HOOP on your iPhone to sync."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Ainda não há dados, abra o HOOP no teu iPhone para tincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Данных пока нет, откройте HOOP на iPhone для синхронизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Aún no hay datos, abra HOOP en su iPhone para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Pas encore de données, ouvrez HOOP sur votre iPhone pour synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Ancora nessun dato, apri HOOP sul tuo iPhone per sincronizzare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Nie ma jeszcze danych. Otwórz HOOP na swoim iPhonie, aby przeprowadzić synchronizację."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HOOP。暂无数据，请在 iPhone 上打开 HOOP 进行同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HOOP。暫無資料，請在 iPhone 上開啟 HOOP 進行同步。"
          }
        }
      }
    },
    "HOOP. Scores out of date, last synced %@. Open HOOP on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Werte veraltet, zuletzt synchronisiert %@. Öffne HOOP auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Scores out of date, last synced %@. Open HOOP on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o HOOP no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Показатели устарели, последняя синхронизация %@. Откройте HOOP на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Resultados fuera de la fecha, último sincronizado %1$@. Abra HOOP en iPhone para refrescarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez HOOP sur iPhone pour vous rafraîchir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Punteggi non aggiornati, ultima sincronizzazione %@. Apri HOOP su iPhone per aggiornare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HOOP. Wyniki nieaktualne, ostatnia synchronizacja %@. Otwórz HOOP na iPhonie, aby odświeżyć."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HOOP。评分已过期，上次同步 %@。请在 iPhone 上打开 HOOP 以刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HOOP。評分已過期，上次同步 %@。請在 iPhone 上開啟 HOOP 以重新整理。"
          }
        }
      }
    },
