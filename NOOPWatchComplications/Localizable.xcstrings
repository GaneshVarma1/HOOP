    "Charge out of date, last synced %@. Open HOOP on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladung veraltet, zuletzt synchronisiert %@. Öffne HOOP auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge out of date, last synced %@. Open HOOP on iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga desatualizada, última sincronização %@. Abra o HOOP no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд устарел, последняя синхронизация %@. Откройте HOOP на iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga fuera de la fecha, última sincronizada %1$@. Abrir HOOP en iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge hors date, dernière synchronisation %1$@. Ouvrez HOOP sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica non aggiornata, ultima sincronizzazione %@. Apri HOOP su iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energia nieaktualny, ostatnia synchronizacja %@. Otwórz HOOP na iPhonie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量数据已过期，上次同步 %@。请在 iPhone 上打开 HOOP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量資料已過期，上次同步 %@。請在 iPhone 上開啟 HOOP。"
          }
        }
      }
    },
